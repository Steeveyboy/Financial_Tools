{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(make help:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m flake8:*)",
      "Bash(.venv/bin/alembic current:*)",
      "Bash(.venv/bin/alembic history:*)",
      "Bash(.venv/bin/alembic heads:*)"
    ],
    "deny": [
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(.venv/bin/alembic upgrade:*)",
      "Bash(.venv/bin/alembic downgrade:*)",
      "Bash(psql:*)",
      "Bash(git push:*)",
      "Read(./.env)"
    ]
  }
}
