# Copy to .env and fill in. .env is gitignored.

# ── Required ────────────────────────────────────────────────────────────────
# SQLAlchemy connection string. Used by the whole findata package.
# Examples:
#   sqlite:///resonance.db
#   postgresql+psycopg2://user:pass@localhost:5432/resonance
DATABASE_URL=sqlite:///resonance.db

# ── Optional ────────────────────────────────────────────────────────────────
# findata.sources.news log verbosity (DEBUG / INFO / WARNING / ERROR). Default: INFO
NEWS_LOG_LEVEL=INFO

# Truthy value logs every SQL statement issued by SQLAlchemy.
ECHO_SQL=0

# findata.sources.market: default OHLCV date range when --start / --end aren't passed.
# START_DATE=2015-01-01
# END_DATE=2026-05-11
